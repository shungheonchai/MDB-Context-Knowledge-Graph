# Copy to .env in this runtime directory. This is the only local environment file.
# Never commit populated .env files. Process environment wins for non-Docker runs.

# =============================================================================
# 1. CONTEXT ENGINEERING STUDIO — required Atlas connection and retrieval settings
# =============================================================================
# Fill in the URI and use your deployment's actual database and lexical index.
# Compatible synthetic fixtures and Search indexes must already exist in Atlas.
CONTEXT_KNOWLEDGE_GRAPH_MONGODB_URI=
CONTEXT_KNOWLEDGE_GRAPH_DATABASE=context_knowledge_graph_demo
CONTEXT_KNOWLEDGE_GRAPH_LEXICAL_INDEX=context_knowledge_graph_rules_lexical
# The vector index name autoEmbed_ruleData is defined in the retrieval code.
# Embedding/reranking runs in Atlas. No answer-LLM key or memory service is needed.

# =============================================================================
# 2. SHARED RUNTIME — defaults normally need no changes
# =============================================================================
CONTEXT_KNOWLEDGE_GRAPH_DEMO_MODE=true
CONTEXT_KNOWLEDGE_GRAPH_MAX_CONCURRENT_RUNS=4
CONTEXT_KNOWLEDGE_GRAPH_RUN_TIMEOUT_SECONDS=180

# =============================================================================
# 3. LEGACY AGENT EXPLORER — optional; keep disabled for Studio-only use
# =============================================================================
# The legacy explorer can run deterministic evidence findings without an LLM.
CONTEXT_KNOWLEDGE_GRAPH_USE_LLM=false
CONTEXT_KNOWLEDGE_GRAPH_CONTEXT_WRITES=false
# Enable context writes only to enrich shared context during legacy investigations.
# Operational records remain read-only; Studio retrieval never writes business data.

# Answer LLM: configure these and set CONTEXT_KNOWLEDGE_GRAPH_USE_LLM=true.
# Example OpenAI-compatible Grove settings; select a model you can access.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# LLM_AUTH_HEADER=api-key
# The Studio never calls this answer LLM. When enabled, its configuration is
# validated at shared-app startup even if you only open the Studio.

# =============================================================================
# 4. LEGACY MEMORY ADAPTER — optional; leave blank for Studio-only use
# =============================================================================
# Hosted standalone memory requires project ID and service-account token.
# BASE_URL optionally overrides the gateway; a local backend uses BASE_URL alone.
# This app does not provision memory or require Agent Engine agent hosting.
# The Studio memory chapter is conceptual and does not call this adapter.
AGENTIC_MEMORY_BASE_URL=
AGENTIC_MEMORY_PROJECT_ID=
AGENTIC_MEMORY_SERVICE_ACCOUNT_TOKEN=
